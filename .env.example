PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/adi-check-pro
JWT_SECRET=
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:3000
# Optional: only if "querySrv ECONNREFUSED" appears on startup
# DNS_SERVERS=8.8.8.8,1.1.1.1

# --- Performance rating (optional) ---
# Defaults live in src/config/performance.js. Uncomment to override without
# touching code.
# PERF_WINDOW_MONTHS=12
# PERF_MIN_TESTS=5
# PERF_DRIVING_FAULT_AVERAGE=6
# PERF_SERIOUS_FAULT_AVERAGE=0.55
# PERF_PHYSICAL_INTERVENTION_RATE=10
# PERF_PASS_RATE=55
# PERF_PASS_RATE_TARGET=70
# PERF_RED_TRIGGERS=3
# PERF_AMBER_TRIGGERS=1

# --- Stripe ---
# Master switch. false = no paywall anywhere, Stripe is never called.
BILLING_ENABLED=false
# Test keys start sk_test_ / pk_test_. Swapping to live is only a key change.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# Create the product and price with: npm run stripe:setup
STRIPE_PRICE_ID=
# From: stripe listen --forward-to localhost:5000/api/billing/webhook
STRIPE_WEBHOOK_SECRET=
BILLING_TRIAL_DAYS=14
# Days a paid period may be overdue before access lapses by itself
BILLING_PERIOD_GRACE_DAYS=3
BILLING_SUCCESS_URL=http://localhost:3000/checkout/complete?session_id={CHECKOUT_SESSION_ID}
BILLING_CANCEL_URL=http://localhost:3000/choose-plan

# --- Plans (amounts live in src/config/plans.js, not here) ---
BILLING_CURRENCY=gbp
# Filled in by: npm run stripe:setup
PLAN_MONTHLY_PRICE_ID=
PLAN_SIXMONTH_PRICE_ID=
PLAN_YEARLY_PRICE_ID=
